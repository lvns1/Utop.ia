{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "process",
            "command": "make",
            "args": ["BUILD_MODE=DEBUG"],
            "windows": {
                "command": "mingw32-make.exe"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build release",
            "type": "process",
            "command": "make",
            "args": ["BUILD_MODE=RELEASE"],
            "windows": {
                "command": "mingw32-make.exe"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "clean",
            "type": "process",
            "command": "make",
            "args": ["clean"],
            "windows": {
                "command": "mingw32-make.exe"
            },
            "problemMatcher": []
        }
    ]
}